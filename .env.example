# PostgreSQL connection string (matches docker-compose.yml for local dev)
DATABASE_URL="postgresql://granabank:granabank@localhost:5432/granabank?schema=public"

# Secret used to sign session JWTs (min. 32 chars). Generate with: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-long-random-secret-of-32-chars"
